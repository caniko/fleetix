{lib}: let
  inherit
    (lib)
    filter
    findFirst
    hasSuffix
    foldl'
    mapAttrs
    removeAttrs
    removeSuffix
    splitString
    ;

  linkAddress = host: linkName: (host.links.${linkName}.address or null);

  hostAddressByKind = host: kind:
    if kind == "lan"
    then host.network.lanIp or null
    else if kind == "direct-link"
    then let
      directLinkIp = host.network.directLinkIp or null;
    in
      if directLinkIp != null
      then directLinkIp
      else linkAddress host "direct-link"
    else linkAddress host kind;

  firstNonNull = values:
    findFirst (value: value != null) null values;

  requireValue = message: value:
    if value == null
    then throw message
    else value;

  lookupHost = topology: hostName:
    topology.hosts.${hostName} or null;

  hostsOnLinkImpl = topology: linkName:
    filter
    (name: builtins.hasAttr linkName (topology.hosts.${name}.links or {}))
    (builtins.attrNames (topology.hosts or {}));

  hostsShareLinkImpl = {
    topology,
    linkName,
    hostNames,
  }:
    builtins.length hostNames
    > 1
    && builtins.all (name: builtins.elem name (hostsOnLinkImpl topology linkName)) hostNames;

  stripPklClass = value:
    if builtins.isAttrs value
    then
      builtins.listToAttrs (
        builtins.filter (entry: entry.value != null) (
          builtins.map (name: {
            inherit name;
            value = stripPklClass value.${name};
          }) (builtins.attrNames (removeAttrs value ["__pkl_class"]))
        )
      )
    else if builtins.isList value
    then map stripPklClass value
    else value;

  hostInZoneImpl = {
    fqdn,
    zone,
  }:
    fqdn == zone || hasSuffix ".${zone}" fqdn;

  zoneForHostImpl = {
    zones,
    fqdn,
  }: let
    matches = filter (zone: hostInZoneImpl {inherit fqdn zone;}) zones;
  in
    if matches == []
    then null
    else
      foldl'
      (best: zone:
        if best == null || builtins.length (splitString "." zone) > builtins.length (splitString "." best)
        then zone
        else best)
      null
      matches;

  declaredZoneForHost = topology: fqdn: let
    tdom = topology.domains or {};
  in
    zoneForHostImpl {
      inherit fqdn;
      zones = (tdom.zones or []) ++ map (entry: entry.name) (tdom.dnsZones or []);
    };

  defaultDnsProvider = "cloudflare";
  defaultIpFamilies = ["ipv4" "ipv6"];

  dnsZone = topology: zone:
    findFirst (entry: entry.name == zone) null (topology.domains.dnsZones or []);

  primaryProvider = entry: entry.provider or defaultDnsProvider;

  zoneProviderIds = entry: let
    primary = primaryProvider entry;
    migration = entry.migrateTo or null;
  in
    [primary] ++ lib.optional (migration != null && migration != primary) migration;

  validatedDnsProviders = topology: let
    tdom = topology.domains or {};
    providers = tdom.dnsProviders or {cloudflare.kind = "cloudflare";};
    check = zone: ids:
      builtins.all (id:
        builtins.hasAttr id providers
        || throw "fleetix DNS: zone '${zone}' references unknown provider '${id}'")
      ids;
  in
    assert builtins.all
    (entry: check entry.name (zoneProviderIds entry))
    (tdom.dnsZones or []);
    assert builtins.all
    (zone: check zone (zoneProviderIds (dnsZone topology zone)))
    ((tdom.zones or []) ++ (tdom.managedZones or [])); providers;

  relativeNameImpl = {
    fqdn,
    zone,
  }:
    if fqdn == zone
    then "@"
    else removeSuffix ".${zone}" fqdn;

  addressPrefix = address:
    if lib.hasInfix ":" address
    then 128
    else 32;

  cnameIntent = {
    name,
    hostname,
    target,
    zone,
    proxied ? false,
    comment ? null,
    source ? null,
  }: {
    inherit name hostname target zone proxied comment source;
    relativeName = relativeNameImpl {
      fqdn = hostname;
      inherit zone;
    };
  };

  resolveHostAddressImpl = {
    topology,
    hostName,
    policy,
    require ? true,
  }: let
    host = lookupHost topology hostName;
    address =
      if host == null
      then null
      else firstNonNull (map (kind: hostAddressByKind host kind) policy);
  in
    if require
    then
      requireValue
      "fleetix.resolveHostAddress: host `${hostName}` has no address for policy [${toString policy}]"
      address
    else address;
in rec {
  gpu = import ./gpu.nix;
  mcp = import ./mcp {inherit lib;};
  gatus = import ./gatus.nix {
    inherit lib;
    fleetixLib = {inherit hosts domains;};
  };

  # Import a fleetix topology sidecar (.nix file generated by pklx eval).
  fromPkl = builtins.import;

  hosts = {
    resolveHostAddress = resolveHostAddressImpl;

    vpnProfile = {
      topology,
      hostName,
      profileName,
      require ? true,
    }: let
      host = lookupHost topology hostName;
      profile =
        if host == null
        then null
        else (host.vpnProfiles or {}).${profileName} or null;
    in
      if require
      then requireValue "fleetix.vpnProfile: `${hostName}` has no VPN profile `${profileName}`" profile
      else profile;

    normalize = {topology}:
      builtins.mapAttrs (_name: host:
        host
        // {
          linkAddresses = builtins.mapAttrs (_linkName: binding: binding.address or null) (host.links or {});
        })
      (topology.hosts or {});
  };

  domains = {
    hostInZone = hostInZoneImpl;

    zoneForHost = {
      topology ? null,
      zones ? let
        managed = (topology.domains or {}).managedZones or [];
      in
        if managed == []
        then (topology.domains or {}).zones or []
        else managed,
      fqdn,
    }:
      zoneForHostImpl {inherit zones fqdn;};

    # Primary provider ID, or null for an undeclared zone.
    zoneProvider = {
      topology,
      zone,
    }: let
      tdom = topology.domains or {};
      entry = dnsZone topology zone;
    in
      builtins.seq (validatedDnsProviders topology) (
        if entry != null || builtins.elem zone ((tdom.zones or []) ++ (tdom.managedZones or []))
        then primaryProvider entry
        else null
      );

    relativeName = relativeNameImpl;

    dynamicHostsForZone = {
      topology,
      zone,
    }:
      filter (host:
        domains.zoneForHost {
          inherit topology;
          inherit (host) fqdn;
        }
        == zone)
      (topology.domains.dynamicHosts or []);

    # Hosts grouped by updater provider ID, with both IDs present during migration.
    dynamicUpdaters = {topology}:
      builtins.seq (validatedDnsProviders topology) (
        mapAttrs (_id: map (entry: entry.host))
        (lib.groupBy (entry: entry.id) (builtins.concatMap (host: let
          zone = domains.zoneForHost {
            inherit topology;
            inherit (host) fqdn;
          };
        in
          if zone == null
          then []
          else
            map (id: {
              inherit id;
              host = host // {families = host.families or defaultIpFamilies;};
            }) (zoneProviderIds (dnsZone topology zone)))
        (topology.domains.dynamicHosts or [])))
      );

    dynamicHostAddressExcludes = {
      topology,
      zone,
    }:
      builtins.concatMap (host: let
        families = host.families or defaultIpFamilies;
        exclude = type: {
          name = relativeNameImpl {
            inherit zone;
            inherit (host) fqdn;
          };
          inherit type;
        };
      in
        lib.optional (builtins.elem "ipv4" families) (exclude "A")
        ++ lib.optional (builtins.elem "ipv6" families) (exclude "AAAA"))
      (domains.dynamicHostsForZone {inherit topology zone;});

    proxiedDynamicHosts = {topology}:
      filter (host: host.proxied or false) (topology.domains.dynamicHosts or []);

    proxiedDynamicHostFqdns = {topology}:
      map (host: host.fqdn) (domains.proxiedDynamicHosts {inherit topology;});

    publicationAddressIntents = {topology}: let
      targets = topology.domains.publicationTargets or {};
      targetNames = map (target: lib.toLower target.hostname) (builtins.attrValues targets);
      uniqueTargets =
        builtins.length targetNames
        == builtins.length (lib.unique targetNames)
        || throw "fleetix publication: destinations must have unique hostnames";
      owners =
        (map (target: {
          inherit (target) hostname;
          inherit target;
        }) (builtins.attrValues targets))
        ++ builtins.concatMap (site: let
          destination = site.publicationTarget or null;
          zone = domains.zoneForHost {
            inherit topology;
            fqdn = site.hostname;
          };
        in
          if destination == null || site.hostname != zone || site.access != "direct" || site.dnsPublication != "managed"
          then []
          else [
            {
              inherit (site) hostname;
              target = targets.${destination} or (throw "fleetix publication: unknown target ${destination}");
            }
          ])
        (builtins.attrValues (topology.services.httpSites or {}));
      uniqueOwners = builtins.attrValues (builtins.listToAttrs (map (owner: {
          name = lib.toLower owner.hostname;
          value = owner;
        })
        owners));
    in
      assert uniqueTargets;
        map (owner: let
          zone = requireValue "fleetix publication: ${owner.hostname} is outside managed zones" (domains.zoneForHost {
            inherit topology;
            fqdn = owner.hostname;
          });
        in {
          inherit zone;
          inherit (owner) hostname;
          relativeName = relativeNameImpl {
            inherit zone;
            fqdn = owner.hostname;
          };
          inherit (owner.target) ipv4;
          ipv6 = owner.target.ipv6 or null;
        })
        uniqueOwners;

    normalize = {topology}: let
      cleanTopology = stripPklClass topology;
      tdom = cleanTopology.domains or {};
      zones = tdom.zones or [];
      managedZones = tdom.managedZones or [];
      hostDomain = name: zone:
        if zone == null
        then null
        else if name == ""
        then zone
        else "${name}.${zone}";
      primaryZone =
        if zones == []
        then null
        else builtins.head zones;
      mailDomain = primaryZone;
      mailHostname = hostDomain (tdom.mailSubdomain or "mail") primaryZone;
      vpnDomain = hostDomain (tdom.vpnSubdomain or "vpn") primaryZone;
    in rec {
      inherit hostDomain;
      host = name: zone: hostDomain name zone;

      inherit mailDomain mailHostname vpnDomain;
      vpnHost = name: hostDomain name vpnDomain;

      serviceHosts = services.serviceHosts {topology = cleanTopology;};

      dynamicHosts = tdom.dynamicHosts or [];
      dnsProviders = validatedDnsProviders cleanTopology;
      dnsZones = tdom.dnsZones or [];
      inherit managedZones;
      pagesSites = tdom.pagesSites or [];
      redirects = tdom.redirects or [];
      publicationTargets = tdom.publicationTargets or {};
    };
  };

  services = rec {
    endpoints = {topology}:
      topology.services.endpoints or {};

    httpSites = {topology}:
      topology.services.httpSites or {};

    endpointByName = endpoints;
    siteByName = httpSites;

    serviceHosts = {topology}:
      mapAttrs (_name: site: site.hostname) (siteByName {inherit topology;});

    endpointsForHost = {
      topology,
      hostName,
    }:
      builtins.listToAttrs (builtins.concatMap (name: let
        endpoint = (endpointByName {inherit topology;}).${name};
      in
        if endpoint.targetHost == hostName
        then [
          {
            inherit name;
            value = endpoint;
          }
        ]
        else []) (builtins.attrNames (endpointByName {inherit topology;})));

    resolveEndpoint = {
      topology,
      endpointName,
      ingressHost ? null,
      require ? true,
    }: let
      endpoints = endpointByName {inherit topology;};
      source = endpoints.${endpointName} or null;
      selectedName =
        if source == null
        then null
        else if ingressHost != null && source.bind == "loopback" && source.targetHost != ingressHost
        then source.remoteVia or null
        else endpointName;
      selected =
        if selectedName == null
        then null
        else endpoints.${selectedName} or null;
      result =
        if selected == null
        then null
        else
          selected
          // {
            name = selectedName;
            sourceEndpoint = endpointName;
          };
    in
      if require
      then requireValue "fleetix.resolveEndpoint: `${endpointName}` is not reachable from `${toString ingressHost}`" result
      else result;

    # A proxy action's primary endpoint followed by its ordered fallbacks.
    resolveProxyEndpoints = {
      topology,
      action,
      ingressHost ? null,
      require ? true,
    }:
      map (endpointName: resolveEndpoint {inherit topology endpointName ingressHost require;})
      ([action.endpoint] ++ action.fallbackEndpoints or []);

    managedDnsCnameIntents = {topology}: let
      providers = validatedDnsProviders topology;
    in
      builtins.concatMap (name: let
        site = (siteByName {inherit topology;}).${name};
        zone = domains.zoneForHost {
          inherit topology;
          fqdn = site.hostname;
        };
        proxied = builtins.elem site.access ["proxied" "cloudflare"];
        declared = declaredZoneForHost topology site.hostname;
        proxyOk =
          !proxied
          || builtins.all (checkedZone:
            builtins.all (id:
              providers.${id}.kind
              == "cloudflare"
              || throw "fleetix DNS: provider '${id}' for zone '${checkedZone}' does not support proxying HTTP site '${name}'")
            (zoneProviderIds (dnsZone topology checkedZone)))
          (lib.optional (declared != null) declared
            ++ lib.optional (site.dnsPublication == "managed" && zone != null && zone != declared) zone);
        destination = site.publicationTarget or null;
        target =
          if destination == null
          then zone
          else ((topology.domains.publicationTargets or {}).${destination} or (throw "fleetix publication: unknown target ${destination}")).hostname;
        policyOk =
          destination
          == null
          || (site.access == "direct" && site.dnsPublication == "managed")
          || throw "fleetix publication: explicit target requires managed DNS-only public access";
      in
        assert policyOk;
        assert proxyOk;
          if
            site.dnsPublication
            != "managed"
            || builtins.elem site.access ["vpn" "lan"]
            || zone == null
            || (destination != null && (lib.toLower site.hostname == lib.toLower zone || lib.toLower site.hostname == lib.toLower target))
          then []
          else [
            (cnameIntent {
              inherit name zone;
              inherit (site) hostname;
              inherit target;
              inherit proxied;
              source = "service";
            })
          ]) (builtins.seq providers (builtins.attrNames (siteByName {inherit topology;})));

    pagesCnameIntents = {
      topology,
      baseZone ? null,
    }: let
      fallbackZone =
        if baseZone != null
        then baseZone
        else if (topology.domains.zones or []) == []
        then null
        else builtins.head topology.domains.zones;
    in
      builtins.concatMap (site: let
        hostname =
          if fallbackZone == null
          then null
          else "${site.subdomain}.${fallbackZone}";
        zone =
          if hostname == null
          then null
          else
            domains.zoneForHost {
              inherit topology;
              fqdn = hostname;
            };
      in
        if hostname == null || zone == null
        then []
        else [
          (cnameIntent {
            inherit zone hostname;
            name = site.subdomain;
            target = site.cnameTarget;
            proxied = false;
            comment = "Pages: ${site.cnameTarget}";
            source = "pages";
          })
        ])
      (topology.domains.pagesSites or []);

    normalize = {topology}: let
      tsvc = topology.services or {};
      endpoints = mapAttrs (_name: stripPklClass) (tsvc.endpoints or {});
      httpSites = mapAttrs (_name: stripPklClass) (tsvc.httpSites or {});
      catalog = mapAttrs (_name: stripPklClass) (tsvc.catalog or {});
      normalizedTopology =
        topology
        // {
          services = {inherit endpoints httpSites catalog;};
        };
    in {
      inherit endpoints httpSites catalog;
      endpointByName = endpoints;
      siteByName = httpSites;
      serviceHosts = services.serviceHosts {topology = normalizedTopology;};
      managedDnsCnameIntents = services.managedDnsCnameIntents {topology = normalizedTopology;};
    };
  };

  localAccess = {
    normalize = {topology}:
      builtins.mapAttrs (_name: stripPklClass) ((topology.deployment or {}).localAccess or {});

    # Policies applying to a client host, with the effective destination
    # resolved (explicit destination, else the target's fallback-link address).
    policiesForHost = {
      topology,
      hostName,
    }: let
      policies = localAccess.normalize {inherit topology;};
      names = builtins.filter (name: builtins.elem hostName (policies.${name}.clients or [])) (builtins.attrNames policies);
    in
      map (name: let
        policy = policies.${name};
        target = lookupHost topology policy.targetHost;
        destination =
          if (policy.destination or null) != null
          then policy.destination
          else if target == null
          then null
          else target.links.${policy.fallbackLink or "wg-home"}.address or null;
      in {
        inherit name destination;
        policy = policy // {inherit destination;};
      })
      names;
  };

  links = {
    hostsShareLink = hostsShareLinkImpl;

    normalize = {topology}: let
      baseLinks = builtins.mapAttrs (linkName: link: let
        hostsOnLink = hostsOnLinkImpl topology linkName;
        serverNames =
          builtins.filter
          (name: (topology.hosts.${name}.links.${linkName} or {}).role or "" == "server")
          hostsOnLink;
        serverName =
          if builtins.length serverNames == 1
          then builtins.head serverNames
          else null;
        clientNames =
          if serverName == null
          then []
          else builtins.filter (name: name != serverName) hostsOnLink;
      in
        link
        // {
          cidr = link.subnet or null;
          serverAddress =
            if serverName == null
            then null
            else topology.hosts.${serverName}.links.${linkName}.address;
          peers =
            builtins.map (name: let
              binding = topology.hosts.${name}.links.${linkName};
            in {
              inherit name;
              publicKey = binding.publicKey or "";
              allowedIPs = ["${binding.address}/${toString (addressPrefix binding.address)}"];
            })
            clientNames
            ++ builtins.map (name: let
              binding = link.devices.${name};
            in
              # The sidecar never runs the Rust validator, so guard the WireGuard essentials here.
              if (binding.role or "client") != "client" || !(builtins.isString (binding.publicKey or null)) || builtins.match "[[:space:]]*" binding.publicKey != null || topology.hosts ? ${name}
              then throw "fleetix links: device '${name}' on link '${linkName}' must be a client with a publicKey and a name no host uses"
              else {
                inherit name;
                inherit (binding) publicKey;
                allowedIPs = ["${binding.address}/${toString (addressPrefix binding.address)}"];
              }) (
              if serverName == null
              then []
              else builtins.attrNames (link.devices or {})
            );
        })
      (topology.links or {});
    in
      baseLinks;
  };

  projections = {
    normalize = {topology}: let
      cleanTopology = stripPklClass topology;
      normalizedHosts = hosts.normalize {topology = cleanTopology;};
      normalizedDomains = domains.normalize {inherit topology;};
      normalizedServices = services.normalize {
        topology = cleanTopology // {hosts = normalizedHosts;};
      };
      normalizedLinks = links.normalize {
        topology = cleanTopology // {hosts = normalizedHosts;};
      };
    in {
      topology = cleanTopology;
      hosts = normalizedHosts;
      domains = normalizedDomains;
      services = normalizedServices;
      links = normalizedLinks;
    };
  };
}
