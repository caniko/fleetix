// Fleet topology schema.
// Consuming flakes own real topology data.

class Link {
  subnet: String
  port: UInt16 = 0
  endpointSubdomain: String? = null
  exemptFromProxy: Boolean = false
}

class LinkBinding {
  address: String
  publicKey: String? = null
  role: String = "client"
  externalInterface: String? = null
  macAddress: String? = null
}

class Network {
  lanIp: String? = null
  lanBroadcast: String? = null
  macAddress: String? = null
  lanInterface: String? = null
  directLinkIp: String? = null
  directLinkMac: String? = null
  directLinkInterface: String? = null
  directLinkPeers: Listing<String> = new Listing {}
  wakeOnLanInterface: String? = null
}

class Rebuild {
  buildHost: String? = null
  useSubstitutes: Boolean = false
  buildCache: BuildCache = new BuildCache {}
}

class BuildCache {
  enable: Boolean = false
  packageAttrNames: Listing<String> = new Listing {}
  keyPrefix: String? = null
}

class User {
  hasAccount: Boolean
  personalPc: Boolean = false
  gpg: String? = null
  signingKey: String? = null
}

typealias VpnConnection = WireGuardVpnConnection

class WireGuardVpnConnection {
  type: "wireguard" = "wireguard"
  addresses: Listing<String>
  privateKeyRef: String
  peers: Listing<WireGuardPeer>
}

class WireGuardPeer {
  publicKey: String
  endpoint: String
  allowedIps: Listing<String>
  persistentKeepaliveSeconds: UInt16? = null
  dynamicEndpointRefreshSeconds: UInt16? = null
  dynamicEndpointRefreshRestartSeconds: UInt16? = null
}

typealias VpnPortForwarding = NatPmpPortForwarding

class NatPmpPortForwarding {
  type: "nat-pmp" = "nat-pmp"
  gateway: String
}

class VpnProfile {
  provider: String
  owner: String? = null
  dnsServers: Listing<String> = new Listing {}
  connection: VpnConnection
  portForwarding: VpnPortForwarding? = null
}

const gpuRenderNodePattern = #"/dev/dri/by-path/pci-[0-9a-fA-F]{4}:[0-9a-fA-F]{2}:[0-9a-fA-F]{2}\.[0-7]-render"#
const gpuVendors = new Listing { "amd"; "intel"; "nvidia" }
const gpuComputeVendors = new Mapping {
  ["oneapi"] = "intel"
  ["rocm"] = "amd"
  ["cuda"] = "nvidia"
}
typealias StableRenderNode = String(matches(Regex(gpuRenderNodePattern)))
typealias GpuVendor = String(gpuVendors.contains(this))
typealias GpuComputeBackend = String(gpuComputeVendors.containsKey(this))

class GpuMedia {
  vendor: GpuVendor
  renderNode: StableRenderNode
  libvaDriver: String
}

// Requested compute stack for the primary GPU (dGPU, otherwise iGPU).
class GpuCompute {
  backend: GpuComputeBackend
}

class Gpu {
  igpu: GpuVendor? = null
  dgpu: GpuVendor? = null
  media: GpuMedia? = null
  compute: GpuCompute? = null
  render: GpuRender? = null
}

// Default game/3D render route, independent of media decoding and compute.
class GpuRender {
  renderNode: StableRenderNode
}

class Storage {
  dataRoot: String? = null
  projectStateRoot: String? = null
  flakeRoot: String? = null
}

class Host {
  system: String
  deviceType: String? = null
  availabilityClass: String = "unknown"
  hostPubkey: String? = null
  hostNames: Listing<String> = new Listing {}
  network: Network = new Network {}
  rebuild: Rebuild = new Rebuild {}
  links: Mapping<String, LinkBinding> = new {}
  users: Mapping<String, User> = new {}
  vpnProfiles: Mapping<String, VpnProfile> = new {}
  gpu: Gpu = new Gpu {}
  storage: Storage = new Storage {}
}

class DynamicHost {
  fqdn: String
  proxied: Boolean = false
  zone: String? = null
}

class Redirect {
  from: String
  to: String
  status: Int = 301
  preservePath: Boolean = true
}

class DnsRecord {
  name: String
  type: String
  data: String? = null
  secret: String? = null
  preference: Int? = null
  proxied: Boolean = false
  ttlAuto: Boolean = true
  comment: String? = null
}

class DnsExclude {
  name: String
  type: String
}

class DnsZone {
  name: String
  defaultTtl: Int = 300
  mode: String = "lenient"
  records: Listing<DnsRecord> = new Listing {}
  exclude: Listing<DnsExclude> = new Listing {}
}

class Domains {
  zones: Listing<String> = new Listing {}
  mailSubdomain: String? = null
  vpnSubdomain: String? = null
  managedZones: Listing<String> = new Listing {}
  dynamicHosts: Listing<DynamicHost> = new Listing {}
  dnsZones: Listing<DnsZone> = new Listing {}
  pagesSites: Listing<PagesSite> = new Listing {}
  redirects: Listing<Redirect> = new Listing {}
}

typealias EndpointTransport = "tcp" | "http" | "https" | "h2c"
typealias EndpointBind = "loopback" | "lan" | "vpn"

class Endpoint {
  targetHost: String
  port: UInt16
  transport: EndpointTransport
  bind: EndpointBind
  remoteVia: String? = null
  tlsServerName: String? = null
  tcpProbe: Boolean = true
}

typealias PathMatch = ExactPathMatch | PrefixPathMatch

class ExactPathMatch {
  type: "exact" = "exact"
  value: String
}

class PrefixPathMatch {
  type: "prefix" = "prefix"
  value: String
}

class HttpMatch {
  paths: Listing<PathMatch> = new Listing {}
  absentQueryParams: Listing<String> = new Listing {}
}

typealias HttpAction = ProxyAction | FilesAction | RedirectAction | RespondAction

class ProxyAction {
  type: "proxy" = "proxy"
  endpoint: String
  stripPrefix: String? = null
}

class FilesAction {
  type: "files" = "files"
  rootRef: String
  indexNames: Listing<String> = new Listing { "index.html" }
}

class RedirectAction {
  type: "redirect" = "redirect"
  to: String
  status: UInt16 = 301
  preserveUri: Boolean = true
}

class RespondAction {
  type: "respond" = "respond"
  status: UInt16
  body: String? = null
}

class HttpRoute {
  match: HttpMatch
  action: HttpAction
  authPolicy: String? = null
  responseHeaders: Mapping<String, Listing<String>> = new {}
}

typealias IngressScope = "public" | "vpn"

class IngressGroup {
  scope: IngressScope
  hosts: Listing<String>
}

typealias HttpAccess = "cloudflare" | "direct" | "vpn"
typealias DnsPublication = "managed" | "external" | "none"

class HttpSite {
  hostname: String
  ingress: String
  access: HttpAccess
  dnsPublication: DnsPublication
  routes: Listing<HttpRoute>
}

class PagesSite {
  subdomain: String
  repository: String
  cnameTarget: String
}

class Services {
  catalog: Mapping<String, ServiceProfile> = new {}
  endpoints: Mapping<String, Endpoint> = new {}
  httpSites: Mapping<String, HttpSite> = new {}
}

/// Generic service facts. Dashboard assignment belongs to monitoring consumers.
typealias ServiceVisibility = "public" | "internal"
typealias ServiceLifecycle = "active" | "on-demand" | "planned" | "retired"

class ServiceProfile {
  displayName: String
  category: String
  domain: String? = null
  visibility: ServiceVisibility = "internal"
  lifecycle: ServiceLifecycle = "active"
  sites: Listing<String> = new Listing {}
  endpoints: Listing<String> = new Listing {}
  health: Mapping<String, ServiceHealthCheck> = new {}
  exclusionReason: String? = null
}

class ServiceHealthCheck {
  category: String? = null
  displayName: String? = null
  visibility: ServiceVisibility? = null
  probe: HealthProbe
  intervalSeconds: UInt32 = 60
  timeoutSeconds: UInt32 = 10
  maxResponseTimeMs: UInt32 = 5000
}

typealias HealthProbe = HttpHealthProbe | TcpHealthProbe | DnsHealthProbe | UnitHealthProbe | JobHealthProbe | ContractHealthProbe

class HttpHealthProbe {
  type: "http" = "http"
  site: String? = null
  endpoint: String? = null
  path: String = "/"
  acceptedStatus: Listing<UInt16> = new Listing { 200 }
  followRedirects: Boolean = true
  body: Listing<BodyAssertion> = new Listing {}
}

class BodyAssertion {
  path: String = ""
  operator: "equals" | "contains" | "nonempty"
  value: String = ""
}

class TcpHealthProbe {
  type: "tcp" = "tcp"
  endpoint: String
}

class DnsHealthProbe {
  type: "dns" = "dns"
  host: String
  query: String
  expected: String
}

class UnitHealthProbe {
  type: "unit" = "unit"
  host: String
  unit: String
}

class JobHealthProbe {
  type: "job" = "job"
  host: String
  unit: String
  maxAgeSeconds: UInt32
}

class ContractHealthProbe {
  type: "contract" = "contract"
  host: String
  contract: String
}

class HealthIntent {
  required: Boolean = false
  endpoint: String? = null
}

class ServiceIntent {
  name: String
  serviceName: String? = null
  requiredHosts: Listing<String> = new Listing {}
  preferredHosts: Listing<String> = new Listing {}
  requiredAvailability: String? = null
  dependsOn: Listing<String> = new Listing {}
  health: HealthIntent = new HealthIntent {}
}

class LocalAccessPolicy {
  clients: Listing<String>
  targetHost: String
  preferredLink: String = "lan"
  fallbackLink: String = "wg-home"
  destination: String? = null
  tcpPorts: Listing<UInt16> = new Listing {}
  udpPorts: Listing<UInt16> = new Listing {}
}

class Deployment {
  serviceIntents: Listing<ServiceIntent> = new Listing {}
  ingressGroups: Mapping<String, IngressGroup> = new {}
  localAccess: Mapping<String, LocalAccessPolicy> = new {}
  publicVirtualCidr: String? = null
  publicPriorities: Mapping<String, Int> = new {}
}

class SshKnownHost {
  hostNames: Listing<String>
  publicKeys: Listing<String>
  provenance: String? = null
}

class Trust {
  sshKnownHosts: Listing<SshKnownHost> = new Listing {}
}

class SshAccess {
  port: UInt16
  hostKeyPath: String
  hostPubKeyPath: String
}

class Access {
  ssh: SshAccess
}
