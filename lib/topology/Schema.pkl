// Fleet topology schema.
// Consuming flakes own real topology data.

class Link {
  subnet: String
  port: UInt16 = 0
  endpointSubdomain: String? = null
  exemptFromProxy: Boolean = false
}

class LinkBinding {
  address: String
  publicKey: String? = null
  role: String = "client"
  externalInterface: String? = null
  macAddress: String? = null
}

class Network {
  lanIp: String? = null
  lanBroadcast: String? = null
  macAddress: String? = null
  lanInterface: String? = null
  directLinkIp: String? = null
  directLinkMac: String? = null
  directLinkInterface: String? = null
  directLinkPeers: Listing<String> = new Listing {}
  wakeOnLanInterface: String? = null
}

class Rebuild {
  buildHost: String? = null
  useSubstitutes: Boolean = false
  buildCache: BuildCache = new BuildCache {}
}

class BuildCache {
  enable: Boolean = false
  packageAttrNames: Listing<String> = new Listing {}
  keyPrefix: String? = null
}

class User {
  hasAccount: Boolean
  personalPc: Boolean = false
  gpg: String? = null
  signingKey: String? = null
}

typealias VpnConnection = WireGuardVpnConnection

class WireGuardVpnConnection {
  type: "wireguard" = "wireguard"
  addresses: Listing<String>
  privateKeyRef: String
  peers: Listing<WireGuardPeer>
}

class WireGuardPeer {
  publicKey: String
  endpoint: String
  allowedIps: Listing<String>
  persistentKeepaliveSeconds: UInt16? = null
  dynamicEndpointRefreshSeconds: UInt16? = null
  dynamicEndpointRefreshRestartSeconds: UInt16? = null
}

typealias VpnPortForwarding = NatPmpPortForwarding

class NatPmpPortForwarding {
  type: "nat-pmp" = "nat-pmp"
  gateway: String
}

class VpnProfile {
  provider: String
  owner: String? = null
  dnsServers: Listing<String> = new Listing {}
  connection: VpnConnection
  portForwarding: VpnPortForwarding? = null
}

class GpuMedia {
  vendor: "amd" | "intel" | "nvidia"
  renderNode: String
  libvaDriver: String
}

class Gpu {
  igpu: String? = null
  dgpu: String? = null
  media: GpuMedia? = null
}

class Storage {
  dataRoot: String? = null
  projectStateRoot: String? = null
  flakeRoot: String? = null
}

class Host {
  system: String
  deviceType: String? = null
  availabilityClass: String = "unknown"
  hostPubkey: String? = null
  hostNames: Listing<String> = new Listing {}
  network: Network = new Network {}
  rebuild: Rebuild = new Rebuild {}
  links: Mapping<String, LinkBinding> = new {}
  users: Mapping<String, User> = new {}
  vpnProfiles: Mapping<String, VpnProfile> = new {}
  gpu: Gpu = new Gpu {}
  storage: Storage = new Storage {}
}

class DynamicHost {
  fqdn: String
  proxied: Boolean = false
  zone: String? = null
}

class Redirect {
  from: String
  to: String
  status: Int = 301
  preservePath: Boolean = true
}

class DnsRecord {
  name: String
  type: String
  data: String? = null
  secret: String? = null
  preference: Int? = null
  proxied: Boolean = false
  ttlAuto: Boolean = true
  comment: String? = null
}

class DnsExclude {
  name: String
  type: String
}

class DnsZone {
  name: String
  defaultTtl: Int = 300
  mode: String = "lenient"
  records: Listing<DnsRecord> = new Listing {}
  exclude: Listing<DnsExclude> = new Listing {}
}

class Domains {
  zones: Listing<String> = new Listing {}
  mailSubdomain: String? = null
  vpnSubdomain: String? = null
  managedZones: Listing<String> = new Listing {}
  dynamicHosts: Listing<DynamicHost> = new Listing {}
  dnsZones: Listing<DnsZone> = new Listing {}
  pagesSites: Listing<PagesSite> = new Listing {}
  redirects: Listing<Redirect> = new Listing {}
}

typealias EndpointTransport = "tcp" | "http" | "https" | "h2c"
typealias EndpointBind = "loopback" | "lan" | "vpn"

class Endpoint {
  targetHost: String
  port: UInt16
  transport: EndpointTransport
  bind: EndpointBind
  remoteVia: String? = null
  tlsServerName: String? = null
  tcpProbe: Boolean = true
}

typealias PathMatch = ExactPathMatch | PrefixPathMatch

class ExactPathMatch {
  type: "exact" = "exact"
  value: String
}

class PrefixPathMatch {
  type: "prefix" = "prefix"
  value: String
}

class HttpMatch {
  paths: Listing<PathMatch> = new Listing {}
  absentQueryParams: Listing<String> = new Listing {}
}

typealias HttpAction = ProxyAction | FilesAction | RedirectAction | RespondAction

class ProxyAction {
  type: "proxy" = "proxy"
  endpoint: String
  stripPrefix: String? = null
}

class FilesAction {
  type: "files" = "files"
  rootRef: String
  indexNames: Listing<String> = new Listing { "index.html" }
}

class RedirectAction {
  type: "redirect" = "redirect"
  to: String
  status: UInt16 = 301
  preserveUri: Boolean = true
}

class RespondAction {
  type: "respond" = "respond"
  status: UInt16
  body: String? = null
}

class HttpRoute {
  match: HttpMatch
  action: HttpAction
  authPolicy: String? = null
  responseHeaders: Mapping<String, Listing<String>> = new {}
}

typealias IngressScope = "public" | "vpn"

class IngressGroup {
  scope: IngressScope
  hosts: Listing<String>
}

typealias HttpAccess = "cloudflare" | "direct" | "vpn"
typealias DnsPublication = "managed" | "external" | "none"

class HttpSite {
  hostname: String
  ingress: String
  access: HttpAccess
  dnsPublication: DnsPublication
  routes: Listing<HttpRoute>
}

class PagesSite {
  subdomain: String
  repository: String
  cnameTarget: String
}

class Services {
  endpoints: Mapping<String, Endpoint> = new {}
  httpSites: Mapping<String, HttpSite> = new {}
}

class HealthIntent {
  required: Boolean = false
  endpoint: String? = null
}

class ServiceIntent {
  name: String
  serviceName: String? = null
  requiredHosts: Listing<String> = new Listing {}
  preferredHosts: Listing<String> = new Listing {}
  requiredAvailability: String? = null
  dependsOn: Listing<String> = new Listing {}
  health: HealthIntent = new HealthIntent {}
}

class Deployment {
  serviceIntents: Listing<ServiceIntent> = new Listing {}
  ingressGroups: Mapping<String, IngressGroup> = new {}
}

class SshKnownHost {
  hostNames: Listing<String>
  publicKeys: Listing<String>
  provenance: String? = null
}

class Trust {
  sshKnownHosts: Listing<SshKnownHost> = new Listing {}
}
