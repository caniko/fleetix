// Compatibility topology entrypoint.
//
// Schema.pkl is the single owner of the portable Fleetix data model. Keep
// this small standalone entrypoint for tools that expect a topology value at
// this path, but never duplicate schema classes here.
import "Schema.pkl" as S

schemaVersion: UInt16 = 2
links = new {}
hosts = new {}
domains = new S.Domains {}
services = new S.Services {}
deployment = new S.Deployment {}
trust = new S.Trust {}
