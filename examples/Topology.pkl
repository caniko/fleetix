// Synthetic Fleetix topology example.
// Production fleet data should live in the consuming flake.
import "../lib/topology/Schema.pkl" as S

schemaVersion: UInt16 = 2
links = new {
  ["mesh"] = new S.Link {
    subnet = "10.44.0.0/24"
    port = 51820
    endpointSubdomain = "mesh"
  }
}

hosts = new {
  ["edge"] = new S.Host {
    system = "x86_64-linux"
    deviceType = "server"
    hostPubkey = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIExampleEdge"
    network = new S.Network { lanIp = "192.0.2.10" }
    links = new {
      ["mesh"] = new S.LinkBinding {
        address = "10.44.0.1"
        publicKey = "edge-wireguard-public-key"
        role = "server"
      }
    }
  }
  ["builder"] = new S.Host {
    system = "x86_64-linux"
    deviceType = "desktop"
    network = new S.Network { lanIp = "192.0.2.20" }
    rebuild = new S.Rebuild { buildHost = "builder" }
    links = new {
      ["mesh"] = new S.LinkBinding {
        address = "10.44.0.2"
        publicKey = "builder-wireguard-public-key"
      }
    }
  }
  ["laptop"] = new S.Host {
    system = "x86_64-linux"
    deviceType = "laptop"
    gpu = new S.Gpu {
      igpu = "amd"
      dgpu = "nvidia"
      media = new S.GpuMedia {
        vendor = "amd"
        renderNode = "/dev/dri/by-path/pci-0000:65:00.0-render"
        libvaDriver = "radeonsi"
      }
    }
    storage = new S.Storage {
      dataRoot = "/data/can"
      projectStateRoot = "/data/ProjectState"
      flakeRoot = "/data/can/fleet"
    }
  }
}

domains = new S.Domains {
  zones = new Listing { "example.test" }
  dynamicHosts = new Listing {
    new S.DynamicHost { fqdn = "example.test" }
    new S.DynamicHost { fqdn = "mesh.example.test" }
  }
  pagesSites = new Listing {
    new S.PagesSite { subdomain = "docs" repository = "example/docs" cnameTarget = "example.github.io" }
  }
  redirects = new Listing {
    new S.Redirect { from = "example.test" to = "https://docs.example.test" }
  }
}

services = new S.Services {
  endpoints = new {
    ["dashboard"] = new S.Endpoint {
      targetHost = "edge"
      port = 8443
      transport = "https"
      bind = "loopback"
    }
    ["multi"] = new S.Endpoint {
      targetHost = "edge"
      port = 8032
      transport = "http"
      bind = "loopback"
    }
    ["metrics"] = new S.Endpoint {
      targetHost = "edge"
      port = 9090
      transport = "tcp"
      bind = "lan"
    }
  }
  httpSites = new {
    ["dashboard"] = new S.HttpSite {
      hostname = "dashboard.example.test"
      ingress = "public-edge"
      access = "direct"
      dnsPublication = "managed"
      routes = new Listing {
        new S.HttpRoute {
          match = new S.HttpMatch {}
          action = new S.ProxyAction { endpoint = "dashboard" }
        }
      }
    }
    ["multi"] = new S.HttpSite {
      hostname = "multi.example.test"
      ingress = "public-edge"
      access = "cloudflare"
      dnsPublication = "managed"
      routes = new Listing {
        new S.HttpRoute {
          match = new S.HttpMatch {
            paths = new Listing {
              new S.PrefixPathMatch { value = "/api" }
            }
          }
          action = new S.ProxyAction { endpoint = "multi" }
        }
        new S.HttpRoute {
          match = new S.HttpMatch {}
          action = new S.RespondAction { status = 404 }
        }
      }
    }
  }
}

deployment = new S.Deployment {
  ingressGroups = new {
    ["public-edge"] = new S.IngressGroup {
      scope = "public"
      hosts = new Listing { "edge" }
    }
  }
  serviceIntents = new Listing {
    new S.ServiceIntent {
      name = "dashboard"
      serviceName = "dashboard"
      requiredHosts = new Listing { "edge" }
      requiredAvailability = "always-on"
      health = new S.HealthIntent {
        required = true
        endpoint = "/healthz"
      }
    }
  }
}

trust = new S.Trust {
  sshKnownHosts = new Listing {
    new S.SshKnownHost {
      hostNames = new Listing { "git.example.test" }
      publicKeys = new Listing { "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIExampleGit" }
      provenance = "observed-known-hosts"
    }
  }
}
